[Unit]
Description=EntityBase Import Dashboard
After=network.target

[Service]
Type=simple
User=ubuntu
AmbientCapabilities=CAP_NET_BIND_SERVICE
WorkingDirectory=/opt/entitybase-import
ExecStart=/usr/local/bin/poetry run python -m src.cli dashboard --port 80
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
